  "step_conclusions": {
    "step_1_gather_decomposition": "Re-gathering 1500-pos cross-attention KV accounts for 50.0%-57.7% of total decode step time (71.6ms at B=4, copying 70.3 MB/step), while self-attention gather is 5.7%-6.9% (8.0-9.8ms, copying 1.5-6.0 MB/step).",
    "step_2_cached_cross_kv": "Caching cross-attention KV closes 90.0% of the gap between Hybrid and Static Batched Contiguous serving.",
    "step_3_zero_copy_view": "Paged storage with contiguous allocation achieves 68.11 tok/s, demonstrating that eliminating gather/scatter copies recovers near-native batched speed.",
    "step_4_direct_paged_kernel": "Triton paged attention kernel compiles and runs natively on Windows RTX 3050, achieving 59.23 tok/s with verified numerical parity."
  }
